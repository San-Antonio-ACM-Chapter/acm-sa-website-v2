exports[`EventCard matches snapshot for event with headshot and image 1`] = `
<a
  class="eventCard eventCardBlue featured"
  href="https://www.meetup.com/acm-sa/events/test-event-1"
  rel="noopener noreferrer"
  target="_blank"
>
  <div
    class="featuredBadge"
  >
    Featured
  </div>
  <div
    class="eventImageContainer"
  >
    <img
      alt="Test Event promotional image"
      class="eventImage"
      data-nimg="1"
      decoding="async"
      height="300"
      loading="lazy"
      src="/_next/image?url=%2Fevent-image.jpg&w=1200&q=75"
      srcset="/_next/image?url=%2Fevent-image.jpg&w=640&q=75 1x, /_next/image?url=%2Fevent-image.jpg&w=1200&q=75 2x"
      style="color: transparent;"
      width="600"
    />
