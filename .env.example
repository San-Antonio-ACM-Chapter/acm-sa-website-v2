# Environment Variables Template
# Copy this to .env.local and fill in your values

# Stripe Configuration (Coming Soon)
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Next.js
NODE_ENV=development

# Deployment
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxxxxxxxxxxx/xxxxxxxxxxxxxxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxxxxx/xxxxxxxxxxxxxxx

# VelociCode Game Jam — Feature Flags
# Set these in Render's environment config (never commit values to the repo).
#
# Theme reveal: when VELOCICODE_THEME is non-empty, a banner appears below
# the hero. Leave blank to hide it (e.g. before kickoff).
VELOCICODE_THEME=
VELOCICODE_KICKOFF_VIDEO=
#
# Earn-a-Patch (Involved) section: visible by default (including when unset).
# Set to "false" to hide it — useful after the jam closes and you're no longer
# actively recruiting sponsors/mentors.
VELOCICODE_SHOW_INVOLVED=
